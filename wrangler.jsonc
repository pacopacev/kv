{
  "name": "kv",
  "main": "src/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  "kv_namespaces": [
    { "binding": "KV_BINDING", "id": "15ab7451de044296bdea3bdf2b841160" }
  ],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfdb",
      "database_id": "4fa75170-04af-4fc2-83d1-499148160ef0"
    }
  ],

  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7aad2543fff5439f8164abee856ac53a"
    },
    {
      "binding": "METABASE_BINDING",
      "id": "18cfca7acd35410a87c911481eba98ae"
    },
    {
      "binding": "RADIO_BINDING",
      "id": "55c20bb0abb34107803ada803a18a28e"
    }
  ],

  "triggers": {
    "crons": ["0 17 * * *"]
    // "crons": ["* * * * *"]
  }
}
